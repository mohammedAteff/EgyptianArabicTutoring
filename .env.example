APP_NAME="Egyptian Arabic with Abdallah"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://boltlanding.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BUSINESS_TIMEZONE=Africa/Cairo

# Optional trusted reverse-proxy CIDRs for CF-IPCountry/X-Country-Code.
# Leave empty when the app is accessed directly; never trust arbitrary client headers.
GEOIP_TRUSTED_PROXIES=
GEOIP_DATABASE_PATH=storage/geoip/GeoLite2-Country.mmdb
# Optional MaxMind GeoLite2 update credentials (never commit real values).
GEOIP_DOWNLOAD_URL=
ANALYTICS_AUTHORITATIVE_CUTOVER_DATE=
MAXMIND_LICENSE_KEY=

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Database (MariaDB / MySQL with InnoDB)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bolt_landing
DB_USERNAME=root
DB_PASSWORD=

# Session & Cache (Database-backed for atomic persistence)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database

# Filesystem & Storage (Section 106: Offsite replication required)
FILESYSTEM_DISK=local
BACKUP_OFFSITE_DISK=s3
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=your_offsite_backup_bucket
AWS_USE_PATH_STYLE_ENDPOINT=false

# Mail Configuration (Configure real SMTP/API provider for production)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="tutor@boltlanding.test"
MAIL_FROM_NAME="${APP_NAME}"

# Backup Retention & Settings
BACKUP_RETENTION_DAYS=30

# Rate Limiting
RATE_LIMIT_ENABLED=true

VITE_APP_NAME="${APP_NAME}"
